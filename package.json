{
  "name": "guesshog",
  "private": true,
  "version": "1.0.0",
  "description": "Guess Who, but every face is a PostHog hedgehog. Real-time multiplayer on Cloudflare Workers + Durable Objects.",
  "type": "module",
  "scripts": {
    "hoggies": "node scripts/sync-hoggies.mjs",
    "dev": "pnpm hoggies && vite",
    "build": "pnpm hoggies && tsc -b && vite build",
    "preview": "pnpm build && vite preview",
    "deploy": "pnpm build && wrangler deploy",
    "typecheck": "tsc -b",
    "test": "node --test --experimental-strip-types worker/*.test.ts",
    "cf-typegen": "wrangler types worker/worker-configuration.d.ts"
  },
  "dependencies": {
    "@posthog/brand": "0.16.0",
    "canvas-confetti": "^1.9.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "~1.65.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "sharp": "^0.35.5",
    "typescript": "^5.9.0",
    "vite": "^8.3.5",
    "wrangler": "^4.154.0"
  },
  "packageManager": "pnpm@12.14.0"
}
