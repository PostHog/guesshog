{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "guesshog",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-20",
  "observability": { "enabled": true },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/r/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "GameRoom" },
      { "name": "DIRECTORY", "class_name": "RoomDirectory" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["RoomDirectory"] }
  ],
  "routes": [{ "pattern": "guesshog.posthog.com", "custom_domain": true }]
}
